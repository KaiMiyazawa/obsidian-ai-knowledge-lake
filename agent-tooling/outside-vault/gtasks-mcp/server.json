{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alvinjchoi/gtasks-mcp",
  "description": "Manage Google Tasks via MCP: list, search, create, update, move, and clear tasks.",
  "repository": {
    "url": "https://github.com/alvinjchoi/gtasks-mcp",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@alvincrave/gtasks-mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GOOGLE_CLIENT_ID",
          "description": "Google OAuth client ID",
          "isRequired": true,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "description": "Google OAuth client secret",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "GOOGLE_REFRESH_TOKEN",
          "description": "Google OAuth refresh token with Tasks scope",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        }
      ]
    }
  ]
}
